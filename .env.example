# Supabase configuration for SpinShine.
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API / Data API in the dashboard).

# --- Required ---

# Server-side service-role key. Bypasses RLS. Used ONLY by the server
# (`src/lib/db.ts`) for admin CRUD and the DB-backed catalog. Never expose
# this to the client. Omit the VITE_ variant — a service-role key must never
# ship in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Required (public / non-secret) ---

# Public publishable key (safe to expose to the browser).
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Project API URL (e.g. https://<project-ref>.supabase.co).
SUPABASE_URL=
VITE_SUPABASE_URL=

# --- Optional (currently unused by the app) ---

# Project ref / id.
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# NOTES
# - `.env` is gitignored; do not commit real secrets.
# - The app runs in a graceful fallback mode (localStorage + built-in defaults)
#   while `SUPABASE_URL` and `SUPABASE_SERVICE_ROLE_KEY` are unset, so the UI
#   still renders during development.